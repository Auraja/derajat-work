# Salin menjadi .env dan ganti semua nilai yang relevan.
# Jangan commit .env.

APP_NAME='Derajat Work'
APP_VERSION=0.1.0
APP_ENV=production

# WAJIB: buat nilai acak unik, misalnya:
#   openssl rand -hex 32
# Jangan gunakan contoh/placeholder ini pada deployment nyata.
APP_SECRET_KEY=GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_BYTE

# Bootstrap admin bersifat opsional. Jika backend mendukung bootstrap via env,
# akun hanya boleh dibuat ketika belum ada dan tidak boleh menimpa akun lama.
# Alternatif yang disarankan: biarkan password kosong lalu jalankan CLI interaktif.
ADMIN_EMAIL=
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# false untuk HTTP loopback lokal. Gunakan true jika request aplikasi memang tiba
# sebagai HTTPS melalui reverse proxy/tunnel yang dipercaya oleh backend.
COOKIE_SECURE=false

# Pisahkan beberapa origin dengan koma. Sesuaikan port jika FRONTEND_PORT berubah.
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# IP frontend yang benar-benar meneruskan request ke backend, gunakan /32.
# Jangan gunakan seluruh rentang private/Docker. Contoh: 172.23.0.3/32
TRUSTED_PROXY_CIDRS=

FRONTEND_PORT=3100
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Empat garis miring berarti path absolut /data/derajat.db di container.
DATABASE_URL=sqlite:////data/derajat.db
SQLITE_VOLUME_NAME=derajat_sqlite

# Hanya untuk scripts/smoke.sh; jangan isi dengan kredensial produksi di file ini.
# Ekspor sebagai environment sementara saat menjalankan smoke test.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
